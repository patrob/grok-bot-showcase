---
import data from '../data/usecases.json';
import Card from '../components/Card.astro';
const sections = [
  { key: 'value', title: 'Real value', emoji: '🛠️', blurb: 'Money found, errands closed, hours handed back.' },
  { key: 'joy', title: 'Joy', emoji: '🌻', blurb: 'Family, hobbies, date nights, and small delights.' },
  { key: 'quirky', title: 'Quirky', emoji: '🦆', blurb: 'Strange, funny, and just plain interesting.' },
  { key: 'workflow', title: 'Workflows worth stealing', emoji: '🔁', blurb: 'Patterns for running a team of bots without losing the plot.' },
];
const by = (k) => data.usecases.filter((u) => u.section === k).sort((a, b) => b.likes - a.likes);
const { meta, templates } = data;
const total = data.usecases.length;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>What people got done with Grok Bot</title>
  <meta name="description" content="Real use cases, bot templates and workflows people shared about Grok Bot, credited to the people who posted them." />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>" />
</head>
<body>
  <header class="hero">
    <p class="kicker">From one X thread</p>
    <h1>What people got done with Grok Bot this week</h1>
    <p class="lede">Lauren (<a href={meta.thread} target="_blank" rel="noopener">@poteto</a>) asked, and hundreds answered. These are {total} of the best replies plus {templates.length} templates you can install, sorted into real value, joy, and the gloriously odd. Every card links to the original post.</p>
    <nav>
      {sections.map((s) => <a href={`#${s.key}`}>{s.emoji} {s.title}</a>)}
      <a href="#templates">📦 Templates</a>
    </nav>
  </header>
  <main>
    {sections.map((s) => (
      <section id={s.key}>
        <div class="head"><h2>{s.emoji} {s.title}</h2><p>{s.blurb}</p></div>
        <div class="grid">{by(s.key).map((u) => <Card item={u} />)}</div>
      </section>
    ))}
    <section id="templates">
      <div class="head"><h2>📦 Templates you can install</h2><p>Shared in the thread by the people who built them.</p></div>
      <div class="grid">{templates.map((t) => <Card item={t} />)}</div>
    </section>
    <section class="also">
      <h2>See also</h2>
      <ul>{meta.seeAlso.map((s) => <li><a href={s.link} target="_blank" rel="noopener">{s.title}</a> by <a href={s.url} target="_blank" rel="noopener">@{s.handle}</a></li>)}</ul>
    </section>
  </main>
  <footer>
    <p>Summaries are paraphrased; quoted lines are verbatim from the linked posts. Credit belongs to each poster. Last scan of the <a href={meta.thread} target="_blank" rel="noopener">thread</a>: {meta.lastScan} ({meta.repliesScanned} replies read). Built by Patrick Robinson's Grok Bot at <a href={meta.request} target="_blank" rel="noopener">his request</a>.</p>
  </footer>
</body>
</html>
<style is:global>
  :root { --bg:#0e0f12; --panel:#16181d; --ink:#eceae4; --mute:#9a9ba3; --line:#262931; --acc:#f2c14e; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font:16px/1.55 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
  a { color:var(--acc); text-decoration:none; } a:hover { text-decoration:underline; }
  .hero, main, footer { max-width:1120px; margin:0 auto; padding:0 20px; }
  .hero { padding-top:64px; padding-bottom:24px; }
  .kicker { text-transform:uppercase; letter-spacing:.12em; font-size:12px; color:var(--mute); margin:0; }
  h1 { font-size:clamp(30px,5vw,52px); line-height:1.08; margin:.25em 0 .4em; letter-spacing:-.02em; }
  .lede { color:#c9c8c2; max-width:720px; font-size:18px; }
  nav { display:flex; flex-wrap:wrap; gap:8px; margin-top:20px; }
  nav a { border:1px solid var(--line); border-radius:999px; padding:6px 14px; color:var(--ink); font-size:14px; }
  nav a:hover { border-color:var(--acc); text-decoration:none; }
  section { padding:36px 0 8px; }
  .head h2 { margin:0; font-size:26px; } .head p { margin:4px 0 18px; color:var(--mute); }
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px; }
  .card { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:18px; display:flex; flex-direction:column; gap:8px; }
  .card h3 { margin:0; font-size:17px; line-height:1.3; }
  .sum { margin:0; color:#cfcec8; font-size:15px; }
  blockquote { margin:2px 0; padding-left:10px; border-left:2px solid var(--acc); color:var(--ink); font-style:italic; font-size:14px; }
  .meta { display:flex; justify-content:space-between; gap:8px; margin-top:auto; font-size:14px; padding-top:6px; }
  .tags { list-style:none; padding:0; margin:0; display:flex; flex-wrap:wrap; gap:6px; }
  .tags li { font-size:11px; color:var(--mute); border:1px solid var(--line); border-radius:6px; padding:1px 7px; }
  .also ul { color:var(--mute); }
  footer { color:var(--mute); font-size:13px; padding-top:30px; padding-bottom:60px; border-top:1px solid var(--line); margin-top:40px; }
</style>
